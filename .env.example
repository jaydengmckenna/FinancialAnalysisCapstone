# Copy this file to .env and fill in real values. Never commit .env.

# OpenAI-compatible API key used by the LLM-driven agents.
OPENAI_API_KEY=

# Base URL for the OpenAI-compatible API endpoint.
OPENAI_BASE_URL=

# Tavily API key used for web search and content retrieval.
TAVILY_API_KEY=

# Model identifier passed to the OpenAI-compatible endpoint.
MODEL_ID=

# Optional. Defaults to ./outputs if unset.
# OUTPUT_DIRECTORY=
