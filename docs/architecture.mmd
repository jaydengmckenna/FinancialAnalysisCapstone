flowchart TD
    USER[Human User]

    subgraph SYSTEM[Financial Analysis Automation]
        ORCH[Orchestrator]

        subgraph AGENTS[Agents]
            PLAN[Research Planning]
            SOURCE[Source Selection]
            EXTRACT[Evidence Extraction]
            ANALYZE[Financial Analysis]
            VALIDATE[Evidence Validation - deterministic]
            REPORT[Report Writing]
        end

        subgraph TOOLS[Deterministic Tools]
            TAVILY[Tavily Search - raw content]
            CALC[Financial Calculations]
            YFIN[yfinance Fallback]
            WRITER[Markdown Writer]
        end
    end

    OUTPUT[Research Report]

    USER -->|Investment research prompt| ORCH

    ORCH --> PLAN
    PLAN --> SOURCE
    SOURCE --> TAVILY
    SOURCE --> EXTRACT
    EXTRACT --> ANALYZE
    ANALYZE --> CALC
    ANALYZE --> YFIN
    ANALYZE --> VALIDATE

    VALIDATE -->|Approved| REPORT
    VALIDATE -.->|Additional research requested| SOURCE
    VALIDATE -.->|Not approved| ORCH

    REPORT --> WRITER
    WRITER --> OUTPUT
    OUTPUT -->|Human review| USER

    classDef human fill:#E8F0FE,stroke:#1A73E8,color:#0B1F33,stroke-width:2px;
    classDef orchestrator fill:#FFF3E0,stroke:#EF6C00,color:#4E2600,stroke-width:2px;
    classDef agent fill:#E8F5E9,stroke:#2E7D32,color:#123A16,stroke-width:2px;
    classDef deterministic_agent fill:#FCE4EC,stroke:#AD1457,color:#3A0A1E,stroke-width:2px;
    classDef tool fill:#F3E5F5,stroke:#7B1FA2,color:#32103E,stroke-width:1.5px;
    classDef output fill:#E0F7FA,stroke:#00838F,color:#003B40,stroke-width:2px;

    class USER human;
    class ORCH orchestrator;
    class PLAN,SOURCE,EXTRACT,ANALYZE,REPORT agent;
    class VALIDATE deterministic_agent;
    class TAVILY,CALC,YFIN,WRITER tool;
    class OUTPUT output;
